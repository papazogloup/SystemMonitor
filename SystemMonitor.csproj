<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.1.0-alpha</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Company>YourCompany</Company>
    <Product>System Monitor</Product>
    <Description>System monitoring tool with CPU, RAM, Network and Temperature monitoring</Description>
    <Copyright>Copyright © 2024</Copyright>
    <AssemblyName>SystemMonitor</AssemblyName>
    <RootNamespace>SystemMonitor</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.Speech" Version="9.0.8" />
  </ItemGroup>

</Project>