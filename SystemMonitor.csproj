<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>3.1.0-SNAPSHOT</Version>
    <AssemblyVersion>3.1.0.0</AssemblyVersion>
    <FileVersion>3.1.0.0</FileVersion>
    <Company>YourCompany</Company>
    <Product>System Monitor</Product>
    <Description>Advanced system monitoring tool with intelligent alerts, voice notifications, and professional UX</Description>
    <Copyright>Copyright © 2025</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>SystemMonitor</AssemblyName>
    <RootNamespace>SystemMonitor</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <!-- Additional metadata -->
    <Authors>YourName</Authors>
    <PackageProjectUrl>https://github.com/yourusername/SystemMonitor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yourusername/SystemMonitor</RepositoryUrl>
    <PackageTags>system-monitor;cpu;ram;temperature;alerts;voice</PackageTags>
    <PackageReleaseNotes>v2.0.0 - Complete UX overhaul with smart settings, enhanced tooltips, and immediate speech control</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Speech" Version="9.0.8" />
  </ItemGroup>

</Project>